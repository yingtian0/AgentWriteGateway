{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentwritegateway.io/schemas/release-profile-v1alpha1.json",
  "title": "Agent Write Gateway Release Profile v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "execution.agentwritegateway.io/v1alpha1"},
    "kind": {"const": "ReleaseProfile"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredCapabilities", "deployment", "verification", "rollback"],
      "properties": {
        "requiredCapabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["deploy", "get_status", "cancel", "rollback", "verify_runtime", "verify_metric", "drain", "shift_traffic"]
          }
        },
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy"],
          "properties": {"strategy": {"type": "string", "minLength": 1}}
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "observationWindow"],
          "properties": {
            "required": {"type": "boolean"},
            "observationWindow": {"type": "string", "minLength": 1}
          }
        },
        "rollback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {"enum": ["automatic", "approval-required", "manual-only", "unsupported"]}
          }
        }
      }
    }
  }
}
